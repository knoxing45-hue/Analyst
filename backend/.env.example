# ============================================================
# MARKET ANALYSIS AGENT — BACKEND CONFIGURATION
# Copy this file to .env and fill in your credentials.
# DeepSeek API key is REQUIRED. Data keys are used if provided.
# ============================================================

# --- Server ---
APP_NAME=Market Analysis Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL) ---
# Default uses SQLite for easy local dev. For production use PostgreSQL.
# Example PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/market_agent
DATABASE_URL=sqlite:///./market_agent.db

# --- Redis (for Celery + caching) ---
REDIS_URL=redis://localhost:6379/0

# --- DeepSeek API (REQUIRED — sign up at https://platform.deepseek.com) ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Primary Market Data (Yahoo Finance — free, no key needed) ---
YFINANCE_ENABLED=true

# --- Fallback Market Data (Alpha Vantage — free API key at alphavantage.co) ---
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# --- TradingView charts (loads public widgets, no key) ---
TRADINGVIEW_ENABLED=true

# --- Default Analysis Settings ---
DEFAULT_RISK_PERCENT=1.0
DEFAULT_SIZING_PREF=lots
DEFAULT_ACCOUNT_SIZE=10000
